# Copy to .env and fill in the empty values.  ./run.sh loads this file with `source`,
# so never leave <placeholder> values in it (bash reads `<` as a redirect and the load fails).

############################
# RUNTIME & APP SETTINGS
############################
API_BASE=http://localhost:8000
DOCS_DIR=data/docs
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# CPU-friendly defaults (the reranker scores RETRIEVAL_TOP_K chunks per question). Original: 100 / 70
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

############################
# LLM / EMBEDDINGS
############################
# Claude on Amazon Bedrock. Auth: a Bedrock API key below, or leave it empty and attach an
# EC2 IAM role allowing bedrock:InvokeModel / bedrock:InvokeModelWithResponseStream.
AWS_REGION=ap-northeast-2
AWS_BEARER_TOKEN_BEDROCK=
# Seoul serves Claude 5.x via the global cross-region profile. Sonnet: global.anthropic.claude-sonnet-5-5
CHAT_MODEL=global.anthropic.claude-haiku-5-5
MAX_TOKENS=2048
# Logged on spans only; not sent to Bedrock (Claude 5.x may reject non-default sampling params)
TEMPERATURE=0.2
EMBEDDING_MODEL=BAAI/bge-m3
# Set to 1 after the embedding model has been downloaded once (skips HF Hub checks at startup)
HF_HUB_OFFLINE=0

############################
# MILVUS (Vector DB)
############################
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=rag_chunks

############################
# REDIS (chat history)
############################
REDIS_URL=redis://localhost:6379/0

############################
# OPENTELEMETRY (SDK → local Collector)
############################
OTEL_SERVICE_NAME=galileo-rag-demo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
# Splunk SDK DeepEval judge needs an OpenAI key; off by default. Quality scores come from Agent Observability evaluators.
OTEL_INSTRUMENTATION_GENAI_EVALS_EVALUATORS=none

############################
# SPLUNK AGENT OBSERVABILITY (splunk-ao SDK, formerly Galileo)
############################
# O11y Cloud deployment. Do not also set SPLUNK_AO_API_KEY / SPLUNK_AO_CONSOLE_URL (on-prem vars).
SPLUNK_AO_REALM=us1
# Ingest token; needs API permissions too for sessions/evaluators, or set SPLUNK_AO_O11Y_API_TOKEN
SPLUNK_AO_O11Y_TOKEN=
SPLUNK_AO_O11Y_API_TOKEN=
SPLUNK_AO_PROJECT=galileo-rag-demo
SPLUNK_AO_AGENT_STREAM=production

# Agent Control (https://docs.galileo.ai/how-to-guides/agent-control/initialize-and-configure-agent-control)
# Leave empty to skip Agent Control (guardrails); the app runs without it
AGENT_CONTROL_URL=
AGENT_CONTROL_TARGET_TYPE=log_stream
AGENT_CONTROL_AGENT_NAME=rag-pipeline
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key

############################
# OPENTELEMETRY COLLECTOR (read by collector.yaml)
############################
SPLUNK_ACCESS_TOKEN=
SPLUNK_REALM=us1
SERVICE_NAMESPACE=galileo-demo
